node_modules/
dist/
.netlify/
.DS_Store

# Local native build outputs. Release APKs/DMGs/EXEs are published as GitHub
# release assets (see scripts/stage-installers.mjs, which fetches them from
# there — never from here), so local copies are disposable.
artifacts-android/

# esbuild writes the bundles into SRC ('src') before copying them to dist/.
# These are generated build artifacts (regenerated by `npm run build`), not source.
src/studio.js
src/darkroom-upload.js
src/stt.js
src/stt-worker.js

# Cached multicolour emoji assets (staged into dist/ by scripts/stage-emoji.mjs,
# fetched from a CDN at deploy time). Disposable, and far too big for git.
vendor/emoji/
